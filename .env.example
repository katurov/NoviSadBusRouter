# Telegram Bot Configuration
TELEGRAM_TOKEN_PROD=your_telegram_bot_token_here

# PostgreSQL Database Configuration
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_QUEUE_NAME=telegram_tasks

# CARTO Basemap API Key
# Get your free API key at: https://carto.com/basemaps/apikey
CARTO_API_KEY=your_carto_api_key_here
